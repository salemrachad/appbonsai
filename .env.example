# Appbonsai configuration. Copy what you need; real .env* files and .dev.vars are gitignored (no secrets live here).

# ---------------------------------------------------------------------------------------------
# Cloudflare (docs/HOSTING.md)
# ---------------------------------------------------------------------------------------------
# The live app's password is a Worker secret: npx wrangler secret put APP_PASSWORD (never in a file).
#
# .env.cloud (read by npm run cf:migrate and cf:backup; the password only ever lives there):
# APPBONSAI_CLOUD_URL=https://appbonsai.<name>.workers.dev
# APPBONSAI_CLOUD_PASSWORD=
#
# .dev.vars (read by npm run cf:dev, the Worker on this machine):
# APP_PASSWORD=local-test

# ---------------------------------------------------------------------------------------------
# Local server (npm run dev / npm run server). Plain environment variables, all optional.
# ---------------------------------------------------------------------------------------------

# APPBONSAI_API_PORT: API port (default 3001). npm run dev's Vite proxy follows it.
# APPBONSAI_API_PORT=3001

# APPBONSAI_HOST: address the server listens on. Default 0.0.0.0 for `npm run server` (reachable on
# the local network), 127.0.0.1 for `npm run dev`.
# APPBONSAI_HOST=0.0.0.0

# APPBONSAI_DB: SQLite file. Default data/appbonsai.db (npm run server) or data/appbonsai-dev.db (npm run dev).
# APPBONSAI_DB=data/appbonsai.db

# APPBONSAI_CORS_ORIGINS: extra browser origins allowed to call the API, comma-separated. Localhost,
# private IPs (10.x, 172.16-31.x, 192.168.x) and *.local names are already allowed.
# APPBONSAI_CORS_ORIGINS=http://my-laptop.lan:3000

# APPBONSAI_SERVE_APP: set to false to stop `npm run server` serving the built app from dist/.
# APPBONSAI_SERVE_APP=true

# ---------------------------------------------------------------------------------------------
# Template leftovers from Google AI Studio (unused by Appbonsai)
# ---------------------------------------------------------------------------------------------
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"
