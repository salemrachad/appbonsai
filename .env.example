# Appbonsai configuration. Copy what you need; real .env* files are gitignored (no secrets live here).

# ---------------------------------------------------------------------------------------------
# Frontend (Vite). Put this one in .env.remote on the laptop:
# ---------------------------------------------------------------------------------------------

# VITE_API_BASE_URL: the Raspberry Pi's Appbonsai API, used ONLY by `npm run dev` / `npm run dev:remote`.
# Base URL without /api. Port 3001 is the Appbonsai server (port 80 on the Pi is Mainsail/Moonraker).
# Ignored by `npm run dev:local` and `npm run build`, which always use the same origin.
VITE_API_BASE_URL=http://ender3.local:3001

# ---------------------------------------------------------------------------------------------
# Server (npm run server / npm run dev:local). Plain environment variables; on the Pi set them in
# the systemd unit (Environment=...). All optional.
# ---------------------------------------------------------------------------------------------

# APPBONSAI_API_PORT: API port (default 3001). dev:local's Vite proxy follows it.
# APPBONSAI_API_PORT=3001

# APPBONSAI_HOST: address the server listens on. Default 0.0.0.0 for `npm run server` (reachable on
# the local network, so the laptop can use the Pi), 127.0.0.1 for `npm run dev:local`.
# APPBONSAI_HOST=0.0.0.0

# APPBONSAI_DB: SQLite file. Default data/appbonsai.db (production) or data/appbonsai-dev.db (dev:local).
# APPBONSAI_DB=data/appbonsai.db

# APPBONSAI_CORS_ORIGINS: extra browser origins allowed to call the API, comma-separated. Localhost,
# private IPs (10.x, 172.16-31.x, 192.168.x) and *.local names are already allowed.
# APPBONSAI_CORS_ORIGINS=http://my-laptop.lan:3000

# APPBONSAI_SERVE_APP: set to false to stop the production server serving the built app from dist/.
# APPBONSAI_SERVE_APP=true

# ---------------------------------------------------------------------------------------------
# Template leftovers from Google AI Studio (unused by Appbonsai)
# ---------------------------------------------------------------------------------------------
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"
