// Appbonsai on Cloudflare (docs/HOSTING.md): npm run cf:deploy (builds dist/ first)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "appbonsai",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // node:http server inside the Durable Object (Express), node:crypto, Buffer
  "compatibility_flags": ["nodejs_compat"],
  // Express → body-parser → iconv-lite, whose bundled form fails to start in the runtime (worker/shims)
  "alias": { "iconv-lite": "./worker/shims/iconv-lite.ts" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker checks the password first for everything but the hashed bundle files
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "TREE", "class_name": "TreeObject" }]
  },
  // One SQLite-backed Durable Object class (the free plan only has these)
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TreeObject"] }],
  // Nightly backups of the tree (server/backup.ts): KV, free without a card (1 GB, 1,000 writes a day)
  // The daily photos' images (server/photoStore.ts): KV too, about 250 KB a photo
  "kv_namespaces": [
    { "binding": "BACKUPS", "id": "c6e6e94df7a14f97a9f2d8df796e0bce" },
    { "binding": "PHOTOS", "id": "c4dbc053de6a4fe1b17ea1f402f3bbdb" }
  ],
  // Feature branches (Workers Builds runs `npx wrangler preview`): each Preview gets its own TREE namespace
  // and storage, so it starts as an empty tree and never sees production's. No BACKUPS or PHOTOS on purpose: KV is not
  // isolated per Preview, and without the binding the object makes no backups. Its password is set apart:
  // npx wrangler preview base-config secret put APP_PASSWORD
  "previews": {
    "durable_objects": { "bindings": [{ "name": "TREE", "class_name": "TreeObject" }] },
    "observability": { "enabled": true }
  },
  "observability": { "enabled": true }
}
