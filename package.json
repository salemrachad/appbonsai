{
  "name": "appbonsai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:remote",
    "dev:remote": "vite --mode remote --port=3000 --strictPort --host=0.0.0.0",
    "dev:local": "concurrently -n web,LOCAL-DEV-API -c green,yellow \"npm:dev:local:web\" \"npm:dev:local:api\"",
    "dev:local:web": "vite --mode fullstack --port=3000 --strictPort --host=0.0.0.0",
    "dev:local:api": "tsx watch --clear-screen=false server/index.ts --local-dev",
    "server": "tsx server/index.ts",
    "db:inspect": "tsx server/inspect.ts",
    "device": "tsx server/device.ts",
    "build": "vite build",
    "cf:dev": "vite build && wrangler dev",
    "cf:deploy": "vite build && wrangler deploy",
    "cf:types": "wrangler types worker/worker-configuration.d.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && tsc --noEmit -p worker",
    "test:scenarios": "tsx scripts/scenarios.ts",
    "test:collector": "tsx scripts/collectorScenarios.ts",
    "test": "npm run -s test:scenarios && npm run -s test:collector && npm run -s test:behaviour && npm run -s test:golden",
    "test:behaviour": "tsx scripts/behaviourScenarios.ts",
    "test:golden": "tsx scripts/golden.ts",
    "check": "npm run -s lint && npm test"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.5",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.4",
    "wrangler": "^4.151.1"
  }
}
